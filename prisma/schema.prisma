generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt?   @db.UnsignedBigInt
  action        String    @db.VarChar(255)
  model_type    String    @db.VarChar(255)
  model_id      BigInt    @db.UnsignedBigInt
  before_values Json?
  after_values  Json?
  ip_address    String?   @db.VarChar(45)
  description   String?   @db.Text
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  users         users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "audit_logs_user_id_foreign")

  @@index([model_type, model_id], map: "audit_logs_model_type_model_id_index")
  @@index([user_id, created_at], map: "audit_logs_user_id_created_at_index")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model inventory_adjustments {
  id              BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  product_id      BigInt                       @db.UnsignedBigInt
  quantity_before Int
  quantity_after  Int
  difference      Int
  reason          inventory_adjustments_reason
  notes           String?                      @db.Text
  verified_by     BigInt?                      @db.UnsignedBigInt
  verified_at     DateTime?                    @db.Timestamp(0)
  created_at      DateTime?                    @db.Timestamp(0)
  updated_at      DateTime?                    @db.Timestamp(0)
  products        products                     @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inventory_adjustments_product_id_foreign")
  users           users?                       @relation(fields: [verified_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_adjustments_verified_by_foreign")

  @@index([created_at], map: "inventory_adjustments_created_at_index")
  @@index([product_id, reason], map: "inventory_adjustments_product_id_reason_index")
  @@index([verified_by], map: "inventory_adjustments_verified_by_foreign")
}

model inventory_alerts {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  product_id          BigInt    @unique(map: "inventory_alerts_product_id_unique") @db.UnsignedBigInt
  low_stock_threshold Int       @default(10)
  critical_threshold  Int       @default(5)
  reorder_quantity    Int       @default(20)
  last_alert_sent_at  DateTime? @db.Timestamp(0)
  is_active           Boolean   @default(true)
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)
  products            products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inventory_alerts_product_id_foreign")

  @@index([is_active], map: "inventory_alerts_is_active_index")
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model notifications {
  id         BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt                 @db.UnsignedBigInt
  title      String                 @db.VarChar(255)
  message    String                 @db.Text
  type       notifications_type     @default(info)
  category   notifications_category @default(system)
  icon       String?                @db.VarChar(255)
  data       Json?
  read_at    DateTime?              @db.DateTime(0)
  is_pinned  Boolean                @default(false)
  created_at DateTime?              @db.Timestamp(0)
  updated_at DateTime?              @db.Timestamp(0)
  users      users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_user_id_foreign")

  @@index([category], map: "notifications_category_index")
  @@index([read_at], map: "notifications_read_at_index")
  @@index([user_id], map: "notifications_user_id_index")
  @@index([user_id, is_pinned, created_at], map: "notifications_user_id_is_pinned_created_at_index")
}

model offline_queue {
  id               BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  kasir_id         BigInt               @db.UnsignedBigInt
  transaction_data Json
  status           offline_queue_status @default(pending)
  retry_count      Int                  @default(0)
  error_message    String?              @db.Text
  synced_at        DateTime?            @db.DateTime(0)
  created_at       DateTime?            @db.Timestamp(0)
  updated_at       DateTime?            @db.Timestamp(0)
  users            users                @relation(fields: [kasir_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "offline_queue_kasir_id_foreign")

  @@index([kasir_id], map: "offline_queue_kasir_id_index")
  @@index([kasir_id, status], map: "offline_queue_kasir_id_status_index")
  @@index([status], map: "offline_queue_status_index")
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model products {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  name                  String                  @db.VarChar(255)
  price                 Int
  stock                 Int                     @default(0)
  category              String?                 @db.VarChar(255)
  image                 String?                 @db.VarChar(255)
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  deleted_at            DateTime?               @db.Timestamp(0)
  inventory_adjustments inventory_adjustments[]
  inventory_alerts      inventory_alerts?
  sale_template_items   sale_template_items[]
  transaction_items     transaction_items[]

  @@index([category], map: "products_category_index")
  @@index([stock], map: "products_stock_index")
}

model refunds {
  id                                BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  transaction_id                    BigInt         @db.UnsignedBigInt
  amount                            Decimal        @db.Decimal(10, 2)
  status                            refunds_status @default(pending)
  reason                            String         @db.Text
  requested_by                      BigInt         @db.UnsignedBigInt
  approved_by                       BigInt?        @db.UnsignedBigInt
  approved_at                       DateTime?      @db.Timestamp(0)
  created_at                        DateTime?      @db.Timestamp(0)
  updated_at                        DateTime?      @db.Timestamp(0)
  users_refunds_approved_byTousers  users?         @relation("refunds_approved_byTousers", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "refunds_approved_by_foreign")
  users_refunds_requested_byTousers users          @relation("refunds_requested_byTousers", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "refunds_requested_by_foreign")
  transactions                      transactions   @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refunds_transaction_id_foreign")

  @@index([approved_by], map: "refunds_approved_by_foreign")
  @@index([requested_by, created_at], map: "refunds_requested_by_created_at_index")
  @@index([transaction_id, status], map: "refunds_transaction_id_status_index")
}

model sale_template_items {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  template_id    BigInt         @db.UnsignedBigInt
  product_id     BigInt         @db.UnsignedBigInt
  quantity       Int            @default(1)
  created_at     DateTime?      @db.Timestamp(0)
  updated_at     DateTime?      @db.Timestamp(0)
  products       products       @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sale_template_items_product_id_foreign")
  sale_templates sale_templates @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sale_template_items_template_id_foreign")

  @@index([product_id], map: "sale_template_items_product_id_foreign")
  @@index([template_id], map: "sale_template_items_template_id_foreign")
}

model sale_templates {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  kasir_id            BigInt                @db.UnsignedBigInt
  name                String                @db.VarChar(255)
  description         String?               @db.Text
  usage_count         Int                   @default(0)
  is_active           Boolean               @default(true)
  created_at          DateTime?             @db.Timestamp(0)
  updated_at          DateTime?             @db.Timestamp(0)
  sale_template_items sale_template_items[]
  users               users                 @relation(fields: [kasir_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sale_templates_kasir_id_foreign")

  @@index([kasir_id], map: "sale_templates_kasir_id_index")
  @@index([kasir_id, is_active], map: "sale_templates_kasir_id_is_active_index")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model shifts {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  kasir_id        BigInt         @db.UnsignedBigInt
  opened_at       DateTime       @db.Timestamp(0)
  closed_at       DateTime?      @db.Timestamp(0)
  opening_balance Decimal        @default(0.00) @db.Decimal(10, 2)
  closing_balance Decimal?       @db.Decimal(10, 2)
  expected_cash   Decimal?       @db.Decimal(10, 2)
  actual_cash     Decimal?       @db.Decimal(10, 2)
  discrepancy     Decimal?       @db.Decimal(10, 2)
  notes           String?        @db.Text
  status          shifts_status  @default(open)
  created_at      DateTime?      @db.Timestamp(0)
  updated_at      DateTime?      @db.Timestamp(0)
  users           users          @relation(fields: [kasir_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "shifts_kasir_id_foreign")
  transactions    transactions[]

  @@index([kasir_id, closed_at], map: "shifts_kasir_id_closed_at_index")
  @@index([kasir_id, status], map: "shifts_kasir_id_status_index")
  @@index([opened_at, closed_at], map: "shifts_opened_at_closed_at_index")
}

model topups {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  amount     Int
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "topups_user_id_foreign")

  @@index([user_id], map: "topups_user_id_foreign")
}

model transaction_items {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  transaction_id BigInt       @db.UnsignedBigInt
  product_id     BigInt       @db.UnsignedBigInt
  quantity       Int
  price          Int
  subtotal       Int
  created_at     DateTime?    @db.Timestamp(0)
  updated_at     DateTime?    @db.Timestamp(0)
  products       products     @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "transaction_items_product_id_foreign")
  transactions   transactions @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "transaction_items_transaction_id_foreign")

  @@index([product_id], map: "transaction_items_product_id_index")
  @@index([transaction_id], map: "transaction_items_transaction_id_foreign")
}

model transactions {
  id                BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  user_id           BigInt                      @db.UnsignedBigInt
  shift_id          BigInt?                     @db.UnsignedBigInt
  customer_name     String?                     @db.VarChar(255)
  ready_at          DateTime?                   @db.Timestamp(0)
  picked_up_at      DateTime?                   @db.Timestamp(0)
  notified_at       DateTime?                   @db.Timestamp(0)
  pickup_code       String?                     @db.VarChar(8)
  total_price       Int
  payment_method    transactions_payment_method @default(saldo)
  status            transactions_status         @default(selesai)
  created_at        DateTime?                   @db.Timestamp(0)
  updated_at        DateTime?                   @db.Timestamp(0)
  refunds           refunds[]
  transaction_items transaction_items[]
  shifts            shifts?                     @relation(fields: [shift_id], references: [id], onUpdate: NoAction, map: "transactions_shift_id_foreign")
  users             users                       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "transactions_user_id_foreign")

  @@index([pickup_code], map: "transactions_pickup_code_index")
  @@index([shift_id], map: "transactions_shift_id_foreign")
  @@index([status, created_at], map: "transactions_status_created_at_index")
  @@index([user_id, status], map: "transactions_user_id_status_index")
}

model users {
  id                                  BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  name                                String                  @db.VarChar(255)
  email                               String                  @unique(map: "users_email_unique") @db.VarChar(255)
  avatar                              String?                 @db.VarChar(255)
  google_id                           String?                 @db.VarChar(255)
  email_verified_at                   DateTime?               @db.Timestamp(0)
  password                            String                  @db.VarChar(255)
  role                                String                  @default("user") @db.VarChar(255)
  remember_token                      String?                 @db.VarChar(100)
  created_at                          DateTime?               @db.Timestamp(0)
  updated_at                          DateTime?               @db.Timestamp(0)
  audit_logs                          audit_logs[]
  inventory_adjustments               inventory_adjustments[]
  notifications                       notifications[]
  offline_queue                       offline_queue[]
  refunds_refunds_approved_byTousers  refunds[]               @relation("refunds_approved_byTousers")
  refunds_refunds_requested_byTousers refunds[]               @relation("refunds_requested_byTousers")
  sale_templates                      sale_templates[]
  shifts                              shifts[]
  topups                              topups[]
  transactions                        transactions[]

  @@index([google_id], map: "users_google_id_index")
  @@index([role], map: "users_role_index")
}

enum offline_queue_status {
  pending
  synced
  failed
}

enum refunds_status {
  pending
  approved
  rejected
}

enum notifications_type {
  info
  success
  warning
  error
}

enum inventory_adjustments_reason {
  stok_opname
  damage
  waste
  manual_correction
}

enum notifications_category {
  purchase
  product
  promotion
  system
  inventory
  shift
}

enum transactions_payment_method {
  saldo
  qris
  cash
  transfer
}

enum shifts_status {
  open
  closed
  verified
}

enum transactions_status {
  pending
  selesai
  batal
  menunggu
  siap
}
